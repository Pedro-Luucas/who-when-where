    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jiti": "2.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
